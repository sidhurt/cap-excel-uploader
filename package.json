{
  "name": "sales-order-uploader",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy sales-order-uploader --delete-services --delete-service-keys --delete-service-brokers",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "dependencies": {
    "@cap-js/sqlite": "^2.0.0",
    "@sap/cds": "^9.3.1",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    },
    "folders": {
      "db": "db",
      "srv": "srv"
    }
  },
  "devDependencies": {
    "@sap/cds-dk": "^9.3.1",
    "mbt": "^1.2.34",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/project1"
  ]
}
